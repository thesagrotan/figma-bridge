{
  "name": "figma-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "start:dist": "node dist/index.js",
    "service:install": "bash scripts/install-service.sh",
