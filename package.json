    "service:logs": "tail -f ~/Library/Logs/figma-mcp/stderr.log"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.2",
    "dotenv": "^17.2.1",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2"
  }
}
